#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // CTL/ESC: hold Left Ctrl, tap Escape.
            // -----------------------------------------------------------------------------------------------------------------------------------------------
            // |    `    |    1    |    2    |    3    |    4    |    5    |                     |    6    |    7    |    8    |    9    |    0    |    -    |
            // |   TAB   |    Q    |    W    |    E    |    R    |    T    |                     |    Y    |    U    |    I    |    O    |    P    |    =    |
            // | CTL/ESC |    A    |    S    |    D    |    F    |    G    |                     |    H    |    J    |    K    |    L    |    ;    |    '    |
            // | LSHIFT  |    Z    |    X    |    C    |    V    |    B    |   DEL   | |  UP-2   |    N    |    M    |    ,    |    .    |    /    | RSHIFT  |
            //                               |  LGUI   |  LALT   |  UP-1   |  SPACE  | |  ENTER  |  BSPC   |    [    |    ]    |

            display-name = "Base";
            bindings = <
&kp GRAVE         &kp N1  &kp N2  &kp N3        &kp N4        &kp N5                               &kp N6         &kp N7            &kp N8             &kp N9   &kp N0    &kp MINUS
&kp TAB           &kp Q   &kp W   &kp E         &kp R         &kp T                                &kp Y          &kp U             &kp I              &kp O    &kp P     &kp EQUAL
&mt LCTRL ESCAPE  &kp A   &kp S   &kp D         &kp F         &kp G                                &kp H          &kp J             &kp K              &kp L    &kp SEMI  &kp SQT
&kp LSHFT         &kp Z   &kp X   &kp C         &kp V         &kp B   &kp DELETE    &mo 2          &kp N          &kp M             &kp COMMA          &kp DOT  &kp FSLH  &kp RSHFT
                                  &kp LEFT_GUI  &kp LEFT_ALT  &mo 1   &kp SPACE     &kp RET        &kp BACKSPACE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        up_1_layer {
            // . = transparent (uses the active lower layer).
            // BT 0-4 select Bluetooth profiles 0-4; BT CLR clears the selected profile.
            // -----------------------------------------------------------------------------------------------------------------------------------------------
            // | BT CLR  |  BT 0   |  BT 1   |  BT 2   |  BT 3   |  BT 4   |                     |    .    |    .    |    .    |    .    |    .    |    .    |
            // |    .    |    .    |    .    |    .    |    .    |    .    |                     |    .    |    .    |    .    |    .    |    .    |    \    |
            // |    .    |    .    |    .    |    .    |    .    |    .    |                     |  LEFT   |  DOWN   |   UP    |  RIGHT  |    .    |    .    |
            // |    .    |    .    |    .    |    .    |    .    |    .    |    .    | |    .    |  HOME   |  PG DN  |  PG UP  |   END   |    .    |    .    |
            //                               |    .    |    .    |    .    |    .    | |    .    |    .    |    .    |    .    |

            display-name = "Up-1";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans          &trans          &trans        &trans     &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans                          &trans          &trans          &trans        &trans     &trans  &kp BACKSLASH
&trans      &trans        &trans        &trans        &trans        &trans                          &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans        &trans    &trans  &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END    &trans  &trans
                                        &trans        &trans        &trans        &trans    &trans  &trans          &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        up_2_layer {
            // . = transparent (uses the active lower layer).
            // -----------------------------------------------------------------------------------------------------------------------------------------------
            // |    .    |   F1    |   F2    |   F3    |   F4    |   F5    |                     |   F6    |   F7    |   F8    |   F9    |   F10   |    .    |
            // |    .    |  MUTE   | VOL DN  | VOL UP  | BRI DN  | BRI UP  |                     |    .    |    .    |    .    |    .    |    .    |    .    |
            // |    .    |    .    |    .    |    .    |    .    |    .    |                     |    .    |    .    |    .    |    .    |    .    |    .    |
            // |    .    |    .    |    .    |    .    |    .    |    .    |    .    | |    .    |    .    |    .    |    .    |    .    |    .    |    .    |
            //                               |    .    |    .    |    .    |    .    | |    .    |    .    |    .    |    .    |

            display-name = "Up-2";
            bindings = <
&trans      &kp F1      &kp F2      &kp F3      &kp F4      &kp F5                              &kp F6      &kp F7      &kp F8      &kp F9      &kp F10     &trans
&trans          &kp C_MUTE      &kp C_VOL_DN    &kp C_VOL_UP    &kp C_BRI_DN    &kp C_BRI_UP                            &trans          &trans          &trans          &trans          &trans          &trans
&trans      &trans      &trans      &trans      &trans      &trans                              &trans      &trans      &trans      &trans      &trans      &trans
&trans      &trans      &trans      &trans      &trans      &trans      &trans          &trans      &trans      &trans      &trans      &trans      &trans      &trans
                                    &trans      &trans      &trans      &trans          &trans      &trans      &trans      &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
